{
  "schema": "kerf-ui-document/v1",
  "name": "PaneSunkenChatWorkspace",
  "catalogs": [
    "@kerfjs/ui"
  ],
  "root": {
    "id": "00000000000000000000000001",
    "type": "@kerfjs/ui:pane",
    "props": {
      "fill": true
    },
    "zones": {
      "content": [
        {
          "id": "00000000000000000000000002",
          "type": "@kerfjs/ui:sized-region",
          "props": {
            "minHeight": {
              "$css": "rem(20)"
            }
          },
          "zones": {
            "children": [
              {
                "id": "00000000000000000000000003",
                "type": "@kerfjs/ui:workbench",
                "props": {
                  "id": "sunken-chat",
                  "label": "Chat Workspace",
                  "mainPane": {
                    "appearance": "sunken"
                  }
                },
                "zones": {
                  "main": [
                    {
                      "id": "00000000000000000000000004",
                      "type": "@kerfjs/ui:content-item",
                      "props": {
                        "children": "Welcome to the conversation"
                      }
                    }
                  ],
                  "mainFooter": [
                    {
                      "id": "00000000000000000000000005",
                      "type": "@kerfjs/ui:content-item",
                      "zones": {
                        "children": [
                          {
                            "id": "00000000000000000000000006",
                            "type": "@kerfjs/ui:text-field",
                            "props": {
                              "ariaLabel": "Message",
                              "placeholder": "Write a message"
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  }
}
