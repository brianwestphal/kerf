{
  "schema": "kerf-ui-document/v1",
  "name": "SurfaceScaffoldAlertDialog",
  "catalogs": [
    "@kerfjs/ui"
  ],
  "root": {
    "id": "00000000000000000000000001",
    "type": "@kerfjs/ui:pane",
    "props": {
      "fill": true
    },
    "zones": {
      "content": [
        {
          "id": "00000000000000000000000002",
          "type": "@kerfjs/ui:button",
          "props": {
            "children": "Delete Topic",
            "tone": "danger",
            "action": "show-dialog",
            "rootAttributes": {
              "data-dialog-id": "catalog-alert-dialog"
            }
          }
        },
        {
          "id": "00000000000000000000000003",
          "type": "@kerfjs/ui:surface-scaffold",
          "props": {
            "label": "Delete Topic",
            "id": "catalog-alert-dialog",
            "describedBy": "catalog-alert-dialog-message",
            "alert": true,
            "size": "small"
          },
          "zones": {
            "children": [
              {
                "id": "00000000000000000000000004",
                "type": "@kerfjs/ui:list-inset-text",
                "zones": {
                  "children": [
                    {
                      "id": "00000000000000000000000005",
                      "type": "@kerfjs/ui:text",
                      "props": {
                        "id": "catalog-alert-dialog-message",
                        "variant": "span",
                        "children": "Delete this topic? Its saved stories are removed too."
                      }
                    }
                  ]
                }
              }
            ],
            "footer": [
              {
                "id": "00000000000000000000000006",
                "type": "@kerfjs/ui:button",
                "props": {
                  "children": "Cancel",
                  "rootAttributes": {
                    "data-dialog-close": ""
                  }
                }
              },
              {
                "id": "00000000000000000000000007",
                "type": "@kerfjs/ui:button",
                "props": {
                  "children": "Delete",
                  "tone": "danger",
                  "rootAttributes": {
                    "data-dialog-close": ""
                  }
                }
              }
            ]
          }
        }
      ]
    }
  }
}
