{
  "schema": "kerf-ui-document/v1",
  "name": "SurfaceScaffoldResizableBottomSheet",
  "catalogs": [
    "@kerfjs/ui"
  ],
  "root": {
    "id": "00000000000000000000000001",
    "type": "@kerfjs/ui:pane",
    "props": {
      "fill": true
    },
    "zones": {
      "content": [
        {
          "id": "00000000000000000000000002",
          "type": "@kerfjs/ui:button",
          "props": {
            "children": "Open New Message",
            "action": "show-dialog",
            "rootAttributes": {
              "data-dialog-id": "catalog-sheet-dialog"
            }
          }
        },
        {
          "id": "00000000000000000000000003",
          "type": "@kerfjs/ui:surface-scaffold",
          "props": {
            "label": "New Message",
            "id": "catalog-sheet-dialog",
            "lightDismiss": true,
            "presentation": "bottom-sheet",
            "bodyInset": "none",
            "minHeight": {
              "$css": "rem(12.5)"
            },
            "resizable": true
          },
          "zones": {
            "children": [
              {
                "id": "00000000000000000000000004",
                "type": "@kerfjs/ui:list",
                "zones": {
                  "children": [
                    {
                      "id": "00000000000000000000000005",
                      "type": "@kerfjs/ui:list-inset-control",
                      "zones": {
                        "children": [
                          {
                            "id": "00000000000000000000000006",
                            "type": "@kerfjs/ui:text-field",
                            "props": {
                              "label": "To",
                              "name": "catalog-sheet-to"
                            }
                          }
                        ]
                      }
                    },
                    {
                      "id": "00000000000000000000000007",
                      "type": "@kerfjs/ui:list-inset-control",
                      "zones": {
                        "children": [
                          {
                            "id": "00000000000000000000000008",
                            "type": "@kerfjs/ui:text-field",
                            "props": {
                              "label": "Subject",
                              "name": "catalog-sheet-subject"
                            }
                          }
                        ]
                      }
                    },
                    {
                      "id": "00000000000000000000000009",
                      "type": "@kerfjs/ui:list-inset-control",
                      "zones": {
                        "children": [
                          {
                            "id": "00000000000000000000000010",
                            "type": "@kerfjs/ui:text-field",
                            "props": {
                              "label": "Message",
                              "name": "catalog-sheet-message",
                              "multiline": true,
                              "rows": 4
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  }
}
