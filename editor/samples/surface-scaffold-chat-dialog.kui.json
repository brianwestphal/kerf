{
  "schema": "kerf-ui-document/v1",
  "name": "SurfaceScaffoldChatDialog",
  "catalogs": [
    "@kerfjs/ui"
  ],
  "root": {
    "id": "00000000000000000000000001",
    "type": "@kerfjs/ui:pane",
    "props": {
      "fill": true
    },
    "zones": {
      "content": [
        {
          "id": "00000000000000000000000002",
          "type": "@kerfjs/ui:button",
          "props": {
            "children": "Open Assistant",
            "action": "show-dialog",
            "rootAttributes": {
              "data-dialog-id": "catalog-chat-dialog"
            }
          }
        },
        {
          "id": "00000000000000000000000003",
          "type": "@kerfjs/ui:surface-scaffold",
          "props": {
            "label": "Assistant",
            "bodyInset": "none",
            "bodyLayout": "fill-last",
            "footerPresentation": "floating",
            "footerInset": "none",
            "id": "catalog-chat-dialog",
            "viewportGutter": {
              "$css": "rem(0.5)"
            },
            "height": {
              "$css": "rem(35)"
            },
            "footerOffset": {
              "$css": "rem(0.5)"
            }
          },
          "zones": {
            "children": [
              {
                "id": "00000000000000000000000004",
                "type": "@kerfjs/ui:state-banner",
                "props": {
                  "title": "Answers use the latest nightly build.",
                  "tone": "neutral"
                }
              },
              {
                "id": "00000000000000000000000005",
                "type": "@kerfjs/ui:list",
                "props": {
                  "gap": "xs",
                  "controlInsets": "tb",
                  "scrollClearance": "block-end",
                  "scrollable": true,
                  "rootAttributes": {
                    "data-demo-chat-transcript": ""
                  }
                },
                "zones": {
                  "children": [
                    {
                      "id": "00000000000000000000000006",
                      "type": "@kerfjs/ui:content-item",
                      "props": {
                        "bubble": "end",
                        "appearance": "brand-loud"
                      },
                      "zones": {
                        "children": [
                          {
                            "id": "00000000000000000000000007",
                            "type": "@kerfjs/ui:text",
                            "props": {
                              "children": "Why did the nightly build fail?",
                              "variant": "span"
                            }
                          }
                        ]
                      }
                    },
                    {
                      "id": "00000000000000000000000008",
                      "type": "@kerfjs/ui:content-item",
                      "props": {
                        "bubble": "start",
                        "appearance": "neutral"
                      },
                      "zones": {
                        "children": [
                          {
                            "id": "00000000000000000000000009",
                            "type": "@kerfjs/ui:text",
                            "props": {
                              "children": "The bundle budget check failed: the demo bundle grew by 213 bytes after the dialog changes landed.",
                              "variant": "span"
                            }
                          }
                        ]
                      }
                    },
                    {
                      "id": "00000000000000000000000010",
                      "type": "@kerfjs/ui:content-item",
                      "props": {
                        "bubble": "end",
                        "appearance": "brand-loud"
                      },
                      "zones": {
                        "children": [
                          {
                            "id": "00000000000000000000000011",
                            "type": "@kerfjs/ui:text",
                            "props": {
                              "children": "Which entry grew?",
                              "variant": "span"
                            }
                          }
                        ]
                      }
                    },
                    {
                      "id": "00000000000000000000000012",
                      "type": "@kerfjs/ui:content-item",
                      "props": {
                        "bubble": "start",
                        "appearance": "neutral"
                      },
                      "zones": {
                        "children": [
                          {
                            "id": "00000000000000000000000013",
                            "type": "@kerfjs/ui:text",
                            "props": {
                              "children": "The surface scaffold entry. Its stylesheet gained the floating footer and fill-last body rules.",
                              "variant": "span"
                            }
                          }
                        ]
                      }
                    },
                    {
                      "id": "00000000000000000000000014",
                      "type": "@kerfjs/ui:content-item",
                      "props": {
                        "bubble": "end",
                        "appearance": "brand-loud"
                      },
                      "zones": {
                        "children": [
                          {
                            "id": "00000000000000000000000015",
                            "type": "@kerfjs/ui:text",
                            "props": {
                              "children": "Is that expected?",
                              "variant": "span"
                            }
                          }
                        ]
                      }
                    },
                    {
                      "id": "00000000000000000000000016",
                      "type": "@kerfjs/ui:content-item",
                      "props": {
                        "bubble": "start",
                        "appearance": "neutral"
                      },
                      "zones": {
                        "children": [
                          {
                            "id": "00000000000000000000000017",
                            "type": "@kerfjs/ui:text",
                            "props": {
                              "children": "Yes. Rebaseline the budget with a reason that names the new dialog layouts.",
                              "variant": "span"
                            }
                          }
                        ]
                      }
                    },
                    {
                      "id": "00000000000000000000000018",
                      "type": "@kerfjs/ui:content-item",
                      "props": {
                        "bubble": "end",
                        "appearance": "brand-loud"
                      },
                      "zones": {
                        "children": [
                          {
                            "id": "00000000000000000000000019",
                            "type": "@kerfjs/ui:text",
                            "props": {
                              "children": "Anything else failing?",
                              "variant": "span"
                            }
                          }
                        ]
                      }
                    },
                    {
                      "id": "00000000000000000000000020",
                      "type": "@kerfjs/ui:content-item",
                      "props": {
                        "bubble": "start",
                        "appearance": "neutral"
                      },
                      "zones": {
                        "children": [
                          {
                            "id": "00000000000000000000000021",
                            "type": "@kerfjs/ui:text",
                            "props": {
                              "children": "No. Every other gate passed, including the browser suite.",
                              "variant": "span"
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ],
            "footer": [
              {
                "id": "00000000000000000000000022",
                "type": "@kerfjs/ui:message-composer",
                "props": {
                  "label": "Message",
                  "name": "catalog-chat-message",
                  "submitOnEnter": true,
                  "id": "catalog-chat-message",
                  "placeholder": "Ask about this build"
                },
                "zones": {
                  "trailing": [
                    {
                      "id": "00000000000000000000000023",
                      "type": "@kerfjs/ui:button",
                      "props": {
                        "children": "Send",
                        "tone": "brand",
                        "action": "send-chat-dialog-message"
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  }
}
