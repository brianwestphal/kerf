{
  "schema": "kerf-ui-document/v1",
  "name": "SurfaceScaffoldCappedModal",
  "catalogs": [
    "@kerfjs/ui"
  ],
  "root": {
    "id": "00000000000000000000000001",
    "type": "@kerfjs/ui:pane",
    "props": {
      "fill": true
    },
    "zones": {
      "content": [
        {
          "id": "00000000000000000000000002",
          "type": "@kerfjs/ui:button",
          "props": {
            "children": "Open Capped Dialog",
            "action": "show-dialog",
            "rootAttributes": {
              "data-dialog-id": "catalog-capped-dialog"
            }
          }
        },
        {
          "id": "00000000000000000000000003",
          "type": "@kerfjs/ui:surface-scaffold",
          "props": {
            "label": "Review Workspace Changes",
            "bodyInset": "none",
            "id": "catalog-capped-dialog",
            "preferredWidth": {
              "$css": "rem(30)"
            },
            "viewportGutter": {
              "$css": "rem(0.5)"
            },
            "maxHeight": {
              "$css": "rem(22.5)"
            }
          },
          "zones": {
            "children": [
              {
                "id": "00000000000000000000000004",
                "type": "@kerfjs/ui:list",
                "zones": {
                  "children": [
                    {
                      "id": "00000000000000000000000005",
                      "type": "@kerfjs/ui:list-inset-text",
                      "props": {
                        "children": "Saved files remain available."
                      }
                    },
                    {
                      "id": "00000000000000000000000006",
                      "type": "@kerfjs/ui:list-inset-text",
                      "props": {
                        "children": "Running tasks will stop."
                      }
                    },
                    {
                      "id": "00000000000000000000000007",
                      "type": "@kerfjs/ui:list-inset-text",
                      "props": {
                        "children": "Terminal sessions will close."
                      }
                    },
                    {
                      "id": "00000000000000000000000008",
                      "type": "@kerfjs/ui:list-inset-text",
                      "props": {
                        "children": "Unsaved output will be lost."
                      }
                    },
                    {
                      "id": "00000000000000000000000009",
                      "type": "@kerfjs/ui:list-inset-text",
                      "props": {
                        "children": "Background synchronization will stop."
                      }
                    },
                    {
                      "id": "00000000000000000000000010",
                      "type": "@kerfjs/ui:list-inset-text",
                      "props": {
                        "children": "Reopen the workspace to resume your work."
                      }
                    }
                  ]
                }
              }
            ],
            "footer": [
              {
                "id": "00000000000000000000000011",
                "type": "@kerfjs/ui:button",
                "props": {
                  "children": "Cancel Review",
                  "rootAttributes": {
                    "data-dialog-close": ""
                  }
                }
              }
            ]
          }
        }
      ]
    }
  }
}
