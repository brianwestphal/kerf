{
  "schema": "kerf-ui-document/v1",
  "name": "SurfaceScaffoldViewportBoundedModal",
  "catalogs": [
    "@kerfjs/ui"
  ],
  "root": {
    "id": "00000000000000000000000001",
    "type": "@kerfjs/ui:pane",
    "props": {
      "fill": true
    },
    "zones": {
      "content": [
        {
          "id": "00000000000000000000000002",
          "type": "@kerfjs/ui:button",
          "props": {
            "children": "Open Bounded Dialog",
            "action": "show-dialog",
            "rootAttributes": {
              "data-dialog-id": "catalog-bounded-dialog"
            }
          }
        },
        {
          "id": "00000000000000000000000003",
          "type": "@kerfjs/ui:surface-scaffold",
          "props": {
            "label": "Close Workspace",
            "id": "catalog-bounded-dialog",
            "describedBy": "catalog-bounded-dialog-summary",
            "size": "large",
            "preferredWidth": {
              "$css": "rem(52)"
            },
            "bodyInset": "none",
            "viewportGutter": {
              "$css": "rem(0.5)"
            },
            "maxHeight": "viewport"
          },
          "zones": {
            "children": [
              {
                "id": "00000000000000000000000004",
                "type": "@kerfjs/ui:list",
                "zones": {
                  "children": [
                    {
                      "id": "00000000000000000000000005",
                      "type": "@kerfjs/ui:list-inset-text",
                      "zones": {
                        "children": [
                          {
                            "id": "00000000000000000000000006",
                            "type": "@kerfjs/ui:text",
                            "props": {
                              "id": "catalog-bounded-dialog-summary",
                              "variant": "span",
                              "children": "Closing this workspace stops its running tasks. Saved files remain available when you reopen it."
                            }
                          }
                        ]
                      }
                    },
                    {
                      "id": "00000000000000000000000007",
                      "type": "@kerfjs/ui:list-inset-text",
                      "props": {
                        "children": "Review your changes before stopping the workspace. Unsaved terminal output will be lost."
                      }
                    }
                  ]
                }
              }
            ],
            "footer": [
              {
                "id": "00000000000000000000000008",
                "type": "@kerfjs/ui:button",
                "props": {
                  "children": "Keep Working",
                  "rootAttributes": {
                    "data-dialog-close": ""
                  }
                }
              },
              {
                "id": "00000000000000000000000009",
                "type": "@kerfjs/ui:button",
                "props": {
                  "children": "Stop and Close",
                  "tone": "brand",
                  "rootAttributes": {
                    "data-dialog-close": ""
                  }
                }
              }
            ]
          }
        }
      ]
    }
  }
}
