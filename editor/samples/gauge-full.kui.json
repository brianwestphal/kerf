{
  "schema": "kerf-ui-document/v1",
  "name": "GaugeFull",
  "catalogs": [
    "@kerfjs/ui"
  ],
  "root": {
    "id": "00000000000000000000000001",
    "type": "@kerfjs/ui:pane",
    "props": {
      "fill": true
    },
    "zones": {
      "content": [
        {
          "id": "00000000000000000000000002",
          "type": "@kerfjs/ui:row",
          "zones": {
            "children": [
              {
                "id": "00000000000000000000000003",
                "type": "@kerfjs/ui:gauge",
                "props": {
                  "value": 420,
                  "max": 1000,
                  "label": "Tokens per Minute",
                  "unit": "tok/min"
                }
              },
              {
                "id": "00000000000000000000000004",
                "type": "@kerfjs/ui:gauge",
                "props": {
                  "value": 420,
                  "max": 1000,
                  "label": "Tokens per Minute, Standby",
                  "unit": "tok/min",
                  "size": {
                    "$css": "remify(220)"
                  }
                }
              },
              {
                "id": "00000000000000000000000005",
                "type": "@kerfjs/ui:button",
                "props": {
                  "children": "Slow Down",
                  "action": "step-gauge-demo",
                  "rootAttributes": {
                    "data-step": "-1"
                  }
                }
              },
              {
                "id": "00000000000000000000000006",
                "type": "@kerfjs/ui:button",
                "props": {
                  "children": "Speed Up",
                  "action": "step-gauge-demo",
                  "rootAttributes": {
                    "data-step": "1"
                  }
                }
              }
            ]
          },
          "props": {
            "vAlign": "middle",
            "gap": "m",
            "wrap": true
          }
        }
      ]
    }
  }
}
