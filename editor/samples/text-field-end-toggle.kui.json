{
  "schema": "kerf-ui-document/v1",
  "name": "TextFieldEndToggle",
  "catalogs": [
    "@kerfjs/ui"
  ],
  "root": {
    "id": "00000000000000000000000001",
    "type": "@kerfjs/ui:pane",
    "props": {
      "fill": true
    },
    "zones": {
      "content": [
        {
          "id": "00000000000000000000000002",
          "type": "@kerfjs/ui:text-field",
          "props": {
            "label": "Password",
            "type": "password",
            "value": "correct horse battery",
            "autocomplete": "off",
            "toggle": {
              "label": "Show Password",
              "action": "text-field-demo-reveal",
              "pressed": false
            }
          },
          "zones": {
            "toggle.icon": [
              {
                "id": "00000000000000000000000003",
                "type": "@kerfjs/ui:lucide-icon",
                "props": {
                  "icon": {
                    "$icon": "eye"
                  },
                  "name": "eye"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
