{
  "schema": "kerf-ui-document/v1",
  "name": "BackdropImageScrimUnderATitle",
  "catalogs": [
    "@kerfjs/ui"
  ],
  "root": {
    "id": "00000000000000000000000001",
    "type": "@kerfjs/ui:pane",
    "props": {
      "label": "Place"
    },
    "zones": {
      "content": [
        {
          "id": "00000000000000000000000002",
          "type": "@kerfjs/ui:backdrop-image",
          "props": {
            "src": {
              "$param": "skylineUrl"
            },
            "alt": "Ridges at dusk under a low sun",
            "position": "bottom",
            "scrim": "bottom",
            "height": {
              "$css": "rem(15)"
            }
          },
          "zones": {
            "children": [
              {
                "id": "00000000000000000000000003",
                "type": "@kerfjs/ui:list-inset-text",
                "props": {
                  "children": "A ridge walk above the harbor, best at dusk."
                }
              }
            ],
            "overlay": [
              {
                "id": "00000000000000000000000004",
                "type": "@kerfjs/ui:toolbar",
                "props": {
                  "label": "Place"
                },
                "zones": {
                  "leading": [
                    {
                      "id": "00000000000000000000000005",
                      "type": "@kerfjs/ui:toolbar-text",
                      "props": {
                        "text": "Coastal Ridge",
                        "size": "xlarge",
                        "headingLevel": 2
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  },
  "params": {
    "skylineUrl": {
      "type": {
        "kind": "string"
      },
      "default": "BackdropImage"
    }
  }
}
