{
  "schema": "kerf-ui-document/v1",
  "name": "ListDetailDialogProjectDetails",
  "catalogs": [
    "@kerfjs/ui"
  ],
  "root": {
    "id": "00000000000000000000000001",
    "type": "@kerfjs/ui:pane",
    "props": {
      "fill": true
    },
    "zones": {
      "content": [
        {
          "id": "00000000000000000000000002",
          "type": "@kerfjs/ui:button",
          "props": {
            "children": "Open Project Details",
            "action": "show-dialog",
            "rootAttributes": {
              "data-dialog-id": "list-detail-dialog-demo"
            }
          }
        },
        {
          "id": "00000000000000000000000003",
          "type": "@kerfjs/ui:list-detail-dialog",
          "props": {
            "id": "list-detail-dialog-demo",
            "label": "Project Details",
            "list": {
              "title": "Projects"
            },
            "detail": {
              "title": "Atlas",
              "description": "Active"
            },
            "backLabel": "Back to Projects",
            "viewportGutter": {
              "$css": "rem(0.5)"
            },
            "height": {
              "$css": "rem(30)"
            }
          },
          "zones": {
            "list.toolbar": [
              {
                "id": "00000000000000000000000004",
                "type": "@kerfjs/ui:toolbar-control-group",
                "zones": {
                  "children": [
                    {
                      "id": "00000000000000000000000005",
                      "type": "@kerfjs/ui:toolbar-control-group#ToolbarButton",
                      "props": {
                        "children": "New",
                        "ariaLabel": "New Project",
                        "action": "log-more"
                      }
                    }
                  ]
                },
                "props": {
                  "appearance": "borderless",
                  "single": true
                }
              }
            ],
            "list.content": [
              {
                "id": "00000000000000000000000006",
                "type": "@kerfjs/ui:list",
                "props": {
                  "controlInsets": "tb"
                },
                "zones": {
                  "children": [
                    {
                      "id": "00000000000000000000000007",
                      "type": "@kerfjs/ui:list-item",
                      "props": {
                        "label": "Atlas",
                        "action": "select-list-detail-project",
                        "selected": true,
                        "description": "Mara Chen",
                        "itemId": "atlas"
                      }
                    },
                    {
                      "id": "00000000000000000000000008",
                      "type": "@kerfjs/ui:list-item",
                      "props": {
                        "label": "Borealis",
                        "action": "select-list-detail-project",
                        "description": "Sam Rivera",
                        "itemId": "borealis"
                      }
                    },
                    {
                      "id": "00000000000000000000000009",
                      "type": "@kerfjs/ui:list-item",
                      "props": {
                        "label": "Cirrus",
                        "action": "select-list-detail-project",
                        "description": "Inez Okafor",
                        "itemId": "cirrus"
                      }
                    },
                    {
                      "id": "00000000000000000000000010",
                      "type": "@kerfjs/ui:list-item",
                      "props": {
                        "label": "Delta",
                        "action": "select-list-detail-project",
                        "description": "Theo Park",
                        "itemId": "delta"
                      }
                    },
                    {
                      "id": "00000000000000000000000011",
                      "type": "@kerfjs/ui:list-item",
                      "props": {
                        "label": "Ember",
                        "action": "select-list-detail-project",
                        "description": "Ana Ruiz",
                        "itemId": "ember"
                      }
                    },
                    {
                      "id": "00000000000000000000000012",
                      "type": "@kerfjs/ui:list-item",
                      "props": {
                        "label": "Fjord",
                        "action": "select-list-detail-project",
                        "description": "Lena Holm",
                        "itemId": "fjord"
                      }
                    }
                  ]
                }
              }
            ],
            "detail.content": [
              {
                "id": "00000000000000000000000013",
                "type": "@kerfjs/ui:list",
                "props": {
                  "controlInsets": "tb"
                },
                "zones": {
                  "children": [
                    {
                      "id": "00000000000000000000000014",
                      "type": "@kerfjs/ui:value-table",
                      "props": {
                        "label": "Project Details"
                      },
                      "zones": {
                        "children": [
                          {
                            "id": "00000000000000000000000015",
                            "type": "@kerfjs/ui:value-table#ValueTableRow",
                            "props": {
                              "label": "Owner",
                              "value": "Mara Chen"
                            }
                          },
                          {
                            "id": "00000000000000000000000016",
                            "type": "@kerfjs/ui:value-table#ValueTableRow",
                            "props": {
                              "label": "Status",
                              "value": "Active"
                            }
                          }
                        ]
                      }
                    },
                    {
                      "id": "00000000000000000000000017",
                      "type": "@kerfjs/ui:list-inset-text",
                      "props": {
                        "children": "Each column scrolls on its own beneath its pinned chrome."
                      }
                    }
                  ]
                }
              }
            ],
            "detail.footer": [
              {
                "id": "00000000000000000000000018",
                "type": "@kerfjs/ui:row",
                "props": {
                  "hAlign": "right",
                  "gap": "xs",
                  "controlInsets": "trbl"
                },
                "zones": {
                  "children": [
                    {
                      "id": "00000000000000000000000019",
                      "type": "@kerfjs/ui:button",
                      "props": {
                        "children": "Done",
                        "emphasis": "secondary",
                        "rootAttributes": {
                          "data-dialog-close": ""
                        }
                      }
                    },
                    {
                      "id": "00000000000000000000000020",
                      "type": "@kerfjs/ui:button",
                      "props": {
                        "children": "Open Project",
                        "tone": "brand",
                        "action": "log-more"
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  }
}
