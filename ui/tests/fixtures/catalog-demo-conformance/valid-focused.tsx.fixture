import { CatalogExample, CatalogExampleStack } from '@kerfjs/ui/catalog';
import { ListItem } from '@kerfjs/ui/list-item';

export function FocusedDemo() {
  return (
    <CatalogExampleStack rootAttributes={{ 'data-demo': 'focused' }}>
      <CatalogExample label="Nested specimen">
        <div data-fixture="nested">
          <ListItem label="Parent" />
          <ListItem label="Nested child" />
        </div>
      </CatalogExample>
      <CatalogExample
        rootAttributes={{ 'data-catalog-geometry-overlay-skip': '' }}
      >
        <p>Explanatory specimen intentionally skipped.</p>
      </CatalogExample>
    </CatalogExampleStack>
  );
}
