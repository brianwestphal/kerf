{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kerf UX Catalog conformance exceptions",
  "type": "object",
  "required": ["schemaVersion", "exceptions"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["route", "file", "rules", "reason", "reviewedIn"],
        "properties": {
          "route": { "type": "string", "minLength": 1 },
          "file": { "type": "string", "pattern": "^ux-demo/demos/.+\\.tsx$" },
          "rules": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "catalog-demo/focused-public-helpers",
                "catalog-demo/focused-root-metadata",
                "catalog-demo/root-attributes"
              ]
            }
          },
          "reason": { "type": "string", "minLength": 20 },
          "reviewedIn": { "type": "string", "pattern": "^KF-[A-Z0-9]+$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
