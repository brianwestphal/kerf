{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/brianwestphal/kerf/main/ui/ai/catalog-authoring.schema.json",
  "title": "Kerf UI Catalog authoring discovery",
  "type": "object",
  "required": [
    "schemaVersion",
    "package",
    "scope",
    "authoritativeGuide",
    "apiSignatures",
    "imports",
    "helpers",
    "taxonomy",
    "metadata"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "package": { "const": "@kerfjs/ui" },
    "scope": { "const": "catalog-demo-authoring" },
    "authoritativeGuide": { "type": "string", "minLength": 1 },
    "apiSignatures": { "type": "string", "minLength": 1 },
    "imports": {
      "type": "object",
      "required": ["layout", "wiring"],
      "properties": {
        "layout": { "const": "@kerfjs/ui/catalog" },
        "wiring": { "const": "@kerfjs/ui/wire-catalog" }
      },
      "additionalProperties": false
    },
    "helpers": {
      "type": "array",
      "items": {
        "enum": [
          "Catalog",
          "CatalogExample",
          "CatalogExampleStack",
          "wireCatalog",
          "wireCatalogGeometryOverlay",
          "revealCatalogEntry"
        ]
      },
      "minItems": 6,
      "uniqueItems": true
    },
    "taxonomy": {
      "type": "object",
      "required": ["kinds", "organization", "compositionTag"],
      "properties": {
        "kinds": {
          "type": "array",
          "items": { "enum": ["component", "composition", "recipe"] },
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true
        },
        "organization": {
          "type": "object",
          "required": [
            "grouping",
            "categoryOrder",
            "withinCategoryKindOrder",
            "withinKindOrder",
            "recipes"
          ],
          "properties": {
            "grouping": { "const": "functional-category" },
            "categoryOrder": { "const": "importance-descending" },
            "withinCategoryKindOrder": {
              "type": "array",
              "items": { "enum": ["component", "composition"] },
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true
            },
            "withinKindOrder": {
              "type": "array",
              "items": {
                "enum": ["importance-descending", "name-ascending"]
              },
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true
            },
            "recipes": { "const": "after-all-functional-groups" }
          },
          "additionalProperties": false
        },
        "compositionTag": { "const": "Composition" }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "required": ["slot", "demo", "geometryOverlaySkip"],
      "properties": {
        "slot": { "const": "rootAttributes" },
        "demo": { "const": "data-demo" },
        "geometryOverlaySkip": {
          "const": "data-catalog-geometry-overlay-skip"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
