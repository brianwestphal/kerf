        "exclusiveWith": []
      }
    ]
  },
  "@kerfjs/ui:wa-select": {
    "_source": "docs/webawesome-theme.md#coverage",
    "children": {
      "mode": "listed",
      "concepts": ["wa-option"],
      "requiredConcepts": ["wa-option"]
    },
    "zones": [
      {
        "id": "options",
        "accepts": ["wa-option"],
        "cardinality": { "min": 1, "max": "unbounded" },
