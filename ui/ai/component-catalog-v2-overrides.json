  "@kerfjs/ui:wa-tab-group": {
    "_source": "docs/webawesome-theme.md#coverage",
    "children": {
      "mode": "listed",
      "concepts": ["wa-tab", "wa-tab-panel"],
      "requiredConcepts": ["wa-tab", "wa-tab-panel"]
    },
    "zones": [
      {
        "id": "tabs",
        "accepts": ["wa-tab"],
        "cardinality": { "min": 1, "max": "unbounded" },
        "exclusiveWith": []
      },
      {
        "id": "panels",
        "accepts": ["wa-tab-panel"],
        "cardinality": { "min": 1, "max": "unbounded" },
        "exclusiveWith": []
      }
    ],
    "diagnostics": [
      {
        "id": "KUI-C108",
