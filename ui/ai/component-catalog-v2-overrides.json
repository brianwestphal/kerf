  },
  "@kerfjs/ui:tab-bar": {
    "_source": "docs/accessibility.md#tabs",
    "contexts": ["tabpanel-navigation"],
    "children": {
      "mode": "listed",
      "concepts": ["app-tab"],
      "requiredConcepts": ["app-tab"]
    },
    "zones": [
      {
        "id": "tabs",
