      "props": {
        "children": {
          "group": "Content",
          "order": 1
        },
        "icon": {
          "group": "Content",
          "order": 2
        },
        "tone": {
          "group": "Appearance",
          "order": 1,
          "control": "segmented"
        },
        "emphasis": {
          "group": "Appearance",
          "order": 2,
          "control": "segmented"
