{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/brianwestphal/kerf/main/ui/ai/component-catalog.schema.json",
  "title": "Kerf UI component catalog",
  "type": "object",
  "required": ["schemaVersion", "package", "description", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "package": { "const": "@kerfjs/ui" },
    "description": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["id", "name", "category", "kind", "source", "purpose", "useWhen", "avoidWhen", "delivery", "links"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["component", "composition", "recipe"] },
        "source": { "enum": ["kerf", "webawesome"] },
        "description": { "type": "string" },
        "purpose": { "type": "string", "minLength": 1 },
        "customElement": { "type": "string" },
        "publicExports": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "useWhen": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "avoidWhen": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "recommendation": { "enum": ["supported", "conditional", "exceptional", "underlying", "avoid"] },
        "alternatives": { "type": "array", "items": { "$ref": "#/$defs/alternative" } },
        "uses": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "wiring": { "type": "array", "items": { "$ref": "#/$defs/wiring" } },
        "appOwns": { "type": "array", "items": { "type": "string" } },
        "variants": { "type": "array", "items": { "type": "string" } },
        "accessibility": { "type": "array", "items": { "type": "string" } },
        "publicClasses": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "publicTokens": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "cssValueProps": { "type": "array", "items": { "$ref": "#/$defs/cssValueProp" }, "uniqueItems": true },
        "geometry": { "$ref": "#/$defs/geometry" },
        "delivery": { "$ref": "#/$defs/delivery" },
        "links": { "$ref": "#/$defs/links" }
      },
      "additionalProperties": false
    },
    "geometry": {
      "type": "object",
      "required": ["margin", "border", "padding"],
      "properties": {
        "margin": { "$ref": "#/$defs/geometryOwner" },
        "border": { "$ref": "#/$defs/geometryOwner" },
        "padding": { "$ref": "#/$defs/geometryOwner" },
        "notes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
      },
      "additionalProperties": false
    },
    "geometryOwner": {
      "enum": ["self", "parent", "child", "none", "conditional"]
    },
    "cssValueProp": {
      "type": "object",
      "required": ["path", "grammar", "helpers", "shorthands", "canonicalShorthands", "exceptionalShorthands", "rawPolicy", "examples"],
      "properties": {
        "path": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*(?:\\[\\]\\.[A-Za-z][A-Za-z0-9]*)?$" },
        "grammar": { "enum": ["length", "size", "flex", "color", "declarations", "media-query", "pixels"] },
        "helpers": { "$ref": "#/$defs/stringList" },
        "nonStandaloneHelpers": { "$ref": "#/$defs/stringList" },
        "shorthands": { "$ref": "#/$defs/stringList" },
        "canonicalShorthands": { "$ref": "#/$defs/stringList" },
        "exceptionalShorthands": { "$ref": "#/$defs/stringList" },
        "rawPolicy": { "enum": ["forbid", "allow", "unsafe-only"] },
        "unsafeHelper": { "type": "string", "minLength": 1 },
        "examples": { "$ref": "#/$defs/stringList" }
      },
      "additionalProperties": false
    },
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "alternative": {
      "type": "object",
      "required": ["id", "relationship"],
      "properties": { "id": { "type": "string" }, "relationship": { "type": "string" }, "when": { "type": "string" } },
      "additionalProperties": false
    },
    "wiring": {
      "type": "object",
      "required": ["export", "import", "required"],
      "properties": {
        "export": { "type": "string" },
        "import": { "type": "string" },
        "required": { "type": "boolean" },
        "reason": { "type": "string" },
        "stateAttributes": {
          "description": "Wiring-owned state attributes: data-* attributes this helper writes at runtime on the entry's elements. The application must not render, remove, or treat them as its own state.",
          "type": "array",
          "items": { "$ref": "#/$defs/stateAttribute" }
        }
      },
      "additionalProperties": false
    },
    "stateAttribute": {
      "type": "object",
      "required": ["name", "on", "meaning"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "pattern": "^data-[a-z0-9]+(-[a-z0-9]+)*$" },
        "on": { "type": "string", "minLength": 1, "description": "The element that carries it: a public class, or the element passed to the helper." },
        "meaning": { "type": "string", "minLength": 1, "description": "What its presence or value means." }
      },
      "additionalProperties": false
    },
    "delivery": {
      "type": "object",
      "required": ["sideEffects"],
      "properties": {
        "moduleImport": { "type": "string" },
        "browserImport": { "type": "string" },
        "manualCssImport": { "type": "string" },
        "registrationImport": { "type": "string" },
        "themeCssImport": { "type": "string" },
        "sideEffects": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "links": {
      "type": "object",
      "required": ["catalogRoute", "documentation", "recipe"],
      "properties": { "catalogRoute": { "type": "string" }, "documentation": { "type": "string" }, "recipe": { "type": "string" } },
      "additionalProperties": false
    }
  }
}
