{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kerf UI AI regression context conditions",
  "type": "object",
  "required": ["schemaVersion", "conditions"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "conditions": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "description", "sourcePaths"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "sourceRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
          "expectedSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "sourcePaths": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    }
  }
}
