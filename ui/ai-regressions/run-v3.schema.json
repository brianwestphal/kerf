{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kerf measured contextual AI regression run v3",
  "type": "object",
  "required": [
    "schemaVersion",
    "evidence",
    "runId",
    "executedAt",
    "executor",
    "harness",
    "conditions",
    "results",
    "summary",
    "limitations"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 3 },
    "evidence": { "const": "measured" },
    "runId": { "type": "string", "minLength": 1 },
    "executedAt": { "type": "string", "format": "date-time" },
    "executor": { "$ref": "#/$defs/executor" },
    "harness": { "$ref": "#/$defs/harness" },
    "conditions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/condition" }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/result" }
    },
    "summary": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/summary" }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "conditionId": {
      "enum": [
        "none",
        "current-guidance",
        "revised-recipes-catalog"
      ]
    },
    "executor": {
      "type": "object",
      "required": [
        "provider",
        "model",
        "modelVersion",
        "settings",
        "isolationUnit",
        "conditionSessions"
      ],
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "modelVersion": { "type": "string", "minLength": 1 },
        "settings": { "type": "object" },
        "isolationUnit": { "const": "condition" },
        "conditionSessions": {
          "type": "object",
          "required": [
            "none",
            "current-guidance",
            "revised-recipes-catalog"
          ],
          "additionalProperties": false,
          "properties": {
            "none": { "type": "string", "minLength": 1 },
            "current-guidance": { "type": "string", "minLength": 1 },
            "revised-recipes-catalog": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "harness": {
      "type": "object",
      "required": [
        "baseRevision",
        "suiteId",
        "suiteSha256",
        "contractSha256",
        "contractSchemaSha256",
        "corpusSha256",
        "corpusSchemaSha256",
        "conditionsSha256",
        "conditionsSchemaSha256",
        "catalogSha256",
        "catalogSchemaSha256",
        "publicApiSignaturesSha256",
        "responseSchemaSha256",
        "evidenceSchemaSha256",
        "runSchemaSha256",
        "typescriptVersion",
        "packageVersions"
      ],
      "additionalProperties": false,
      "properties": {
        "baseRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "suiteId": { "const": "kerf-ui-authoring-v3" },
        "suiteSha256": { "$ref": "#/$defs/digest" },
        "contractSha256": { "$ref": "#/$defs/digest" },
        "contractSchemaSha256": { "$ref": "#/$defs/digest" },
        "corpusSha256": { "$ref": "#/$defs/digest" },
        "corpusSchemaSha256": { "$ref": "#/$defs/digest" },
        "conditionsSha256": { "$ref": "#/$defs/digest" },
        "conditionsSchemaSha256": { "$ref": "#/$defs/digest" },
        "catalogSha256": { "$ref": "#/$defs/digest" },
        "catalogSchemaSha256": { "$ref": "#/$defs/digest" },
        "publicApiSignaturesSha256": { "$ref": "#/$defs/digest" },
        "responseSchemaSha256": { "$ref": "#/$defs/digest" },
        "evidenceSchemaSha256": { "$ref": "#/$defs/digest" },
        "runSchemaSha256": { "$ref": "#/$defs/digest" },
        "typescriptVersion": { "type": "string", "minLength": 1 },
        "packageVersions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "condition": {
      "type": "object",
      "required": ["id", "sourceRevision", "sha256", "sources"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/conditionId" },
        "sourceRevision": { "type": ["string", "null"] },
        "sha256": { "$ref": "#/$defs/digest" },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/source" }
        }
      }
    },
    "evidenceRef": {
      "type": "object",
      "required": ["path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "result": {
      "type": "object",
      "required": [
        "caseId",
        "condition",
        "sessionId",
        "requestOrdinal",
        "promptSha256",
        "caseContextSha256",
        "guidanceContextSha256",
        "requestPath",
        "requestSha256",
        "responsePath",
        "responseSha256",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "caseId": { "type": "string", "minLength": 1 },
        "condition": { "$ref": "#/$defs/conditionId" },
        "sessionId": { "type": "string", "minLength": 1 },
        "requestOrdinal": { "type": "integer", "minimum": 1 },
        "promptSha256": { "$ref": "#/$defs/digest" },
        "caseContextSha256": { "$ref": "#/$defs/digest" },
        "guidanceContextSha256": { "$ref": "#/$defs/digest" },
        "requestPath": { "type": "string", "minLength": 1 },
        "requestSha256": { "$ref": "#/$defs/digest" },
        "responsePath": { "type": "string", "minLength": 1 },
        "responseSha256": { "$ref": "#/$defs/digest" },
        "evidence": {
          "type": "object",
          "required": ["static", "compile", "browser", "humanVisual"],
          "additionalProperties": false,
          "properties": {
            "static": { "$ref": "#/$defs/evidenceRef" },
            "compile": { "$ref": "#/$defs/evidenceRef" },
            "browser": { "$ref": "#/$defs/evidenceRef" },
            "humanVisual": { "$ref": "#/$defs/evidenceRef" }
          }
        }
      }
    },
    "count": {
      "type": "object",
      "required": ["passes", "applicable"],
      "additionalProperties": false,
      "properties": {
        "passes": { "type": "integer", "minimum": 0 },
        "applicable": { "type": "integer", "minimum": 0 }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "condition",
        "totalCases",
        "static",
        "compile",
        "browser",
        "visualMean",
        "visualDimensions"
      ],
      "additionalProperties": false,
      "properties": {
        "condition": { "$ref": "#/$defs/conditionId" },
        "totalCases": { "type": "integer", "minimum": 1 },
        "static": { "$ref": "#/$defs/count" },
        "compile": { "$ref": "#/$defs/count" },
        "browser": { "$ref": "#/$defs/count" },
        "visualMean": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 2
        },
        "visualDimensions": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          }
        }
      }
    }
  }
}
