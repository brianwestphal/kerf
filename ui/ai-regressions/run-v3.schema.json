{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kerf measured contextual AI regression run v3",
  "type": "object",
  "required": ["schemaVersion", "evidence", "runId", "executedAt", "executor", "harness", "results", "summary", "limitations"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 3 },
    "evidence": { "enum": ["canned", "measured"] },
    "runId": { "type": "string", "minLength": 1 },
    "executedAt": { "type": "string", "format": "date-time" },
    "executor": {
      "type": "object", "required": ["provider", "model", "modelVersion", "settings"], "additionalProperties": false,
      "properties": { "provider": { "type": "string" }, "model": { "type": "string" }, "modelVersion": { "type": "string" }, "settings": { "type": "object" } }
    },
    "harness": {
      "type": "object", "required": ["baseRevision", "suiteSha256", "compatibilitySha256", "diagnosticRegistrySha256", "environment"], "additionalProperties": false,
      "properties": {
        "baseRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$" }, "suiteSha256": { "$ref": "#/$defs/digest" },
        "compatibilitySha256": { "$ref": "#/$defs/digest" }, "diagnosticRegistrySha256": { "$ref": "#/$defs/digest" }, "environment": { "$ref": "#/$defs/environment" }
      }
    },
    "results": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/result" } },
    "summary": { "$ref": "#/$defs/metrics" },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "condition": { "enum": ["guidance-only", "guidance-static", "guidance-static-browser"] },
    "ref": { "type": "object", "required": ["path", "sha256"], "additionalProperties": false, "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/digest" } } },
    "environment": {
      "type": "object", "required": ["node", "platform", "arch", "typescript", "playwright", "browsers", "lockfileSha256"], "additionalProperties": false,
      "properties": {
        "node": { "type": "string" }, "platform": { "type": "string" }, "arch": { "type": "string" }, "typescript": { "type": "string" }, "playwright": { "type": "string" },
        "browsers": { "type": "object", "required": ["chromium", "firefox", "webkit"], "additionalProperties": false, "properties": { "chromium": { "type": "string", "minLength": 1 }, "firefox": { "type": "string", "minLength": 1 }, "webkit": { "type": "string", "minLength": 1 } } }, "lockfileSha256": { "$ref": "#/$defs/digest" }
      }
    },
    "usage": {
      "type": "object", "required": ["inputTokens", "outputTokens", "cachedInputTokens", "reasoningTokens", "totalTokens", "unavailableReason"], "additionalProperties": false,
      "properties": {
        "inputTokens": { "type": ["integer", "null"], "minimum": 0 }, "outputTokens": { "type": ["integer", "null"], "minimum": 0 },
        "cachedInputTokens": { "type": ["integer", "null"], "minimum": 0 }, "reasoningTokens": { "type": ["integer", "null"], "minimum": 0 },
        "totalTokens": { "type": ["integer", "null"], "minimum": 0 }, "unavailableReason": { "type": ["string", "null"] }
      }
    },
    "attempt": {
      "type": "object",
      "required": ["ordinal", "request", "rawResponse", "response", "sessionId", "startedAt", "providerDurationMs", "usage", "contextBytes", "tooling", "feedbackExposed", "evidence"],
      "additionalProperties": false,
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1 }, "request": { "$ref": "#/$defs/ref" }, "rawResponse": { "$ref": "#/$defs/ref" }, "response": { "$ref": "#/$defs/ref" },
        "sessionId": { "type": "string", "minLength": 1 }, "startedAt": { "type": "string", "format": "date-time" }, "providerDurationMs": { "type": "integer", "minimum": 0 },
        "usage": { "$ref": "#/$defs/usage" }, "contextBytes": { "type": "integer", "minimum": 0 },
        "tooling": {
          "type": "object", "required": ["doctorCache", "doctorBrowser", "browser"], "additionalProperties": false,
          "properties": {
            "doctorCache": { "const": false },
            "doctorBrowser": { "const": false },
            "browser": { "type": "object", "required": ["owner", "url", "contexts", "signalForwarded"], "additionalProperties": false, "properties": { "owner": { "const": "@kerfjs/ui/evaluator" }, "url": { "type": "string", "minLength": 1 }, "contexts": { "type": "array", "minItems": 4, "items": { "type": "string" } }, "signalForwarded": { "const": true } } }
          }
        },
        "feedbackExposed": { "type": "array", "uniqueItems": true, "items": { "enum": ["static", "compile", "browser"] } },
        "evidence": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/ref" } }
      }
    },
    "resultMetrics": {
      "type": "object", "required": ["firstPass", "clean", "repairIterations", "residualDiagnostics", "falsePositives", "adjudicatedFindings", "runtimeMs", "runtimeByStageMs", "totalTokens", "contextBytes"], "additionalProperties": false,
      "properties": {
        "firstPass": { "type": "boolean" }, "clean": { "type": "boolean" }, "repairIterations": { "type": "integer", "minimum": 0 },
        "residualDiagnostics": { "type": "array", "items": { "type": "string" } }, "falsePositives": { "type": "integer", "minimum": 0 }, "adjudicatedFindings": { "type": "integer", "minimum": 0 },
        "runtimeMs": { "type": "integer", "minimum": 0 }, "runtimeByStageMs": { "$ref": "#/$defs/runtimeByStage" }, "totalTokens": { "type": ["integer", "null"], "minimum": 0 }, "contextBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "result": {
      "type": "object", "required": ["caseId", "condition", "replicate", "sessionId", "initialModelInputSha256", "attempts", "terminalReason", "metrics"], "additionalProperties": false,
      "properties": {
        "caseId": { "type": "string" }, "condition": { "$ref": "#/$defs/condition" }, "replicate": { "type": "integer", "minimum": 1 }, "sessionId": { "type": "string" },
        "initialModelInputSha256": { "$ref": "#/$defs/digest" }, "attempts": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "#/$defs/attempt" } },
        "terminalReason": { "enum": ["clean", "max-attempts", "tool-failure", "cancelled"] }, "metrics": { "$ref": "#/$defs/resultMetrics" }
      }
    },
    "metrics": {
      "type": "object", "required": ["totalCells", "firstPassSuccesses", "cleanCells", "repairIterations", "residualDiagnostics", "falsePositives", "adjudicatedFindings", "runtimeMs", "runtimeByStageMs", "totalTokens", "contextBytes"], "additionalProperties": false,
      "properties": {
        "totalCells": { "type": "integer", "minimum": 1 }, "firstPassSuccesses": { "type": "integer", "minimum": 0 }, "cleanCells": { "type": "integer", "minimum": 0 },
        "repairIterations": { "type": "array", "items": { "type": "integer", "minimum": 0 } }, "residualDiagnostics": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "falsePositives": { "type": "integer", "minimum": 0 }, "adjudicatedFindings": { "type": "integer", "minimum": 0 }, "runtimeMs": { "type": "integer", "minimum": 0 }, "runtimeByStageMs": { "$ref": "#/$defs/runtimeByStage" },
        "totalTokens": { "type": ["integer", "null"], "minimum": 0 }, "contextBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "runtimeByStage": {
      "type": "object", "required": ["provider", "static", "compile", "browser", "humanVisual"], "additionalProperties": false,
      "properties": {
        "provider": { "type": "integer", "minimum": 0 }, "static": { "type": "integer", "minimum": 0 }, "compile": { "type": "integer", "minimum": 0 },
        "browser": { "type": "integer", "minimum": 0 }, "humanVisual": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
