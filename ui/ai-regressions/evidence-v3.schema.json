{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kerf AI UI quality evidence v3",
  "type": "object",
  "required": [
    "schemaVersion",
    "suiteId",
    "caseId",
    "condition",
    "responseSha256",
    "stage",
    "recordedAt",
    "records"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 3 },
    "suiteId": { "const": "kerf-ui-authoring-v3" },
    "caseId": { "type": "string", "minLength": 1 },
    "condition": {
      "enum": ["none", "current-guidance", "revised-recipes-catalog"]
    },
    "responseSha256": { "$ref": "#/$defs/digest" },
    "stage": { "enum": ["static", "compile", "browser", "human-visual"] },
    "recordedAt": { "type": "string", "format": "date-time" },
    "environment": { "type": "object" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "outcome", "detail"],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^(static|compile|browser|visual)\\.[a-z][a-z0-9-]*$"
          },
          "outcome": {
            "enum": ["pass", "fail", "not-applicable", "not-recorded"]
          },
          "rating": { "type": "number", "minimum": 0, "maximum": 2 },
          "detail": { "type": "string", "minLength": 1 }
        }
      }
    },
    "reviewer": { "type": "string", "minLength": 1 }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
  "allOf": [
    {
      "if": { "properties": { "stage": { "const": "human-visual" } } },
      "then": { "required": ["reviewer", "artifacts"] }
    },
    {
      "if": {
        "properties": { "stage": { "enum": ["static", "compile", "browser"] } }
      },
      "then": { "not": { "required": ["reviewer"] } }
    }
  ]
}
