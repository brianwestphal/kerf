{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kerf UI AI regression suite-v3 feedback policies",
  "type": "object",
  "required": ["schemaVersion", "guidance", "maxAttempts", "conditions"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 3 },
    "guidance": {
      "type": "object",
      "required": ["description", "sourcePaths"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "sourceRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "expectedSha256": { "$ref": "#/$defs/digest" },
        "sourcePaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 10 },
    "conditions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/condition" }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "condition": {
      "type": "object",
      "required": ["id", "description", "feedbackStages"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": ["guidance-only", "guidance-static", "guidance-static-browser"]
        },
        "description": { "type": "string", "minLength": 1 },
        "feedbackStages": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["static", "compile", "browser"] }
        }
      }
    }
  }
}
