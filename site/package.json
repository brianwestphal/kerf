{
  "name": "kerf-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "preinstall": "node scripts/check-install-script-policy.mjs",
    "sync-docs": "node scripts/sync-docs.mjs",
    "build-examples": "node scripts/build-examples.mjs",
    "build-icons": "node scripts/build-icons.mjs",
    "gen-llms-txt": "node scripts/gen-llms-txt.mjs",
    "lint": "eslint src/scripts tests playwright.config.ts --max-warnings 0",
    "prebuild": "npm run sync-docs && npm run build-examples && npm run build-icons && npm run gen-llms-txt",
    "dev": "npm run build && astro preview",
    "predev:hmr": "npm run sync-docs && npm run build-examples && npm run build-icons && npm run gen-llms-txt",
    "dev:hmr": "astro dev",
    "start": "npm run dev",
    "build": "astro build",
    "preview": "astro preview",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "typecheck": "node node_modules/typescript/bin/tsc -p src/scripts/tsconfig.json",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.39.0",
    "@kerfjs/ui": "^4.4.1",
    "astro": "^6.0.0",
    "dompurify": "^3.2.0",
    "kerfjs": "file:..",
    "marked": "^15.0.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "typescript": "^6.0.3",
    "vite": "^7.0.0"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": true,
    "file:../..": false
  }
}
