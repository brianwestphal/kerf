{
  "name": "kerf-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "preinstall": "node scripts/check-install-script-policy.mjs",
    "sync-docs": "node scripts/sync-docs.mjs",
    "build-examples": "node scripts/build-examples.mjs",
    "build-icons": "node scripts/build-icons.mjs",
    "gen-llms-txt": "node scripts/gen-llms-txt.mjs",
    "lint": "eslint src/scripts scripts tests playwright.config.ts vite.config.ts --max-warnings 0",
    "prebuild": "npm run sync-docs && npm run build-examples && npm run build-icons && npm run gen-llms-txt && npm run build-content",
    "build-content": "node scripts/build-content.mjs",
    "dev": "npm run build && npm run preview",
    "dev:hmr": "npm run dev",
    "start": "npm run dev",
    "build": "vite build && node --import tsx scripts/render-site.tsx && pagefind --site dist --output-subdir pagefind",
    "preview": "vite preview",
    "test:unit": "node --test tests/*.unit.test.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "pretypecheck": "npm run build-content",
    "typecheck": "node node_modules/typescript/bin/tsc -p src/scripts/tsconfig.json"
  },
  "dependencies": {
    "@kerfjs/ui": "^4.4.1",
    "dompurify": "^3.4.15",
    "kerfjs": "file:..",
    "marked": "^15.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "pagefind": "^1.4.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": false,
    "file:../..": false
  }
}
