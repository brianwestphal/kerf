{
  "name": "kerf-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "preinstall": "node scripts/check-install-script-policy.mjs",
    "sync-docs": "node scripts/sync-docs.mjs",
    "build-examples": "node scripts/build-examples.mjs",
    "build-icons": "node scripts/build-icons.mjs",
    "gen-llms-txt": "node scripts/gen-llms-txt.mjs",
    "prebuild": "npm run sync-docs && npm run build-examples && npm run build-icons && npm run gen-llms-txt",
    "dev": "npm run build && astro preview",
    "predev:hmr": "npm run sync-docs && npm run build-examples && npm run build-icons && npm run gen-llms-txt",
    "dev:hmr": "astro dev",
    "start": "npm run dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "pretest:visual": "npm run build",
    "preview:visual": "node scripts/serve-visual-preview.mjs",
    "test:visual": "playwright test tests/full-visual-audit.spec.ts --project=chromium",
    "check:audit": "npm audit --include=dev --audit-level=high"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.0",
    "astro": "^7.3.2",
    "dompurify": "^3.4.15",
    "kerfjs": "file:..",
    "marked": "^15.0.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true,
    "file:../..": false
  }
}
