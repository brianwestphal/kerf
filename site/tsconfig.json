{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "kerfjs",
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src", "scripts", "tests", "playwright.config.ts", "vite.config.ts"],
  "exclude": ["dist"]
}
