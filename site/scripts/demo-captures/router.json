{
  "width": 880,
  "height": 510,
  "output": "site/public/demos/router.svg",
  "optimize": true,
  "vars": {
    "base": "http://localhost:4188",
    "easeOut": "cubic-bezier(0.215,0.61,0.355,1)"
  },
  "cursor": "auto",
  "frames": [
    {
      "transition": { "type": "cut", "duration": 0 },
      "input": "${base}/router/",
      "waitFor": ".rt-bar",
      "wait": 300,
      "duration": 900
    },
    {
      "continue": true,
      "transition": { "type": "cut", "duration": 0 },
      "actions": [
        { "type": "click", "selector": "a[href='#/guides']" },
        { "type": "wait", "ms": 160 }
      ],
      "animations": [
        { "selector": ".rt-view", "property": "translateY", "from": "8px", "to": "0px", "duration": 280, "easing": "${easeOut}" }
      ],
      "duration": 950
    },
    {
      "continue": true,
      "transition": { "type": "cut", "duration": 0 },
      "actions": [
        { "type": "click", "selector": "a[href='#/guides/getting-started']" },
        { "type": "wait", "ms": 160 }
      ],
      "animations": [
        { "selector": ".rt-view", "property": "translateY", "from": "8px", "to": "0px", "duration": 280, "easing": "${easeOut}" }
      ],
      "duration": 950
    },
    {
      "continue": true,
      "transition": { "type": "cut", "duration": 0 },
      "actions": [
        { "type": "click", "selector": ".rt-navbtn[data-nav='back']" },
        { "type": "wait", "ms": 160 }
      ],
      "duration": 900
    },
    {
      "continue": true,
      "transition": { "type": "cut", "duration": 0 },
      "actions": [
        { "type": "click", "selector": "a[href='#/about']" },
        { "type": "wait", "ms": 160 }
      ],
      "animations": [
        { "selector": ".rt-view", "property": "translateY", "from": "8px", "to": "0px", "duration": 280, "easing": "${easeOut}" }
      ],
      "duration": 1000
    }
  ]
}
