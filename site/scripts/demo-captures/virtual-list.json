{
  "width": 700,
  "height": 560,
  "output": "site/public/demos/virtual-list.svg",
  "optimize": true,
  "vars": {
    "base": "http://localhost:4188",
    "easeOut": "cubic-bezier(0.215,0.61,0.355,1)"
  },
  "cursor": "auto",
  "frames": [
    {
      "transition": { "type": "cut", "duration": 0 },
      "input": "${base}/virtual-list/",
      "waitFor": "#list .vl-row",
      "wait": 350,
      "duration": 1000
    },
    {
      "continue": true,
      "transition": { "type": "cut", "duration": 0 },
      "actions": [
        { "type": "evaluate", "script": "var l=document.getElementById('list'); l.style.height='560px'; window.dispatchEvent(new Event('resize'));" },
        { "type": "wait", "ms": 350 },
        { "type": "evaluate", "script": "document.getElementById('list').scrollTop=0;" },
        { "type": "wait", "ms": 200 }
      ],
      "scroll": { "selector": "#list", "pattern": "0px/2.1s, 2600px/4.4s [ease-in-out]", "clip": [0, 186, 700, 560], "prescroll": false },
      "duration": 5500
    },
    {
      "continue": true,
      "transition": { "type": "cut", "duration": 0 },
      "actions": [
        { "type": "evaluate", "script": "var l=document.getElementById('list'); l.style.height=''; l.scrollTop=0; window.dispatchEvent(new Event('resize'));" },
        { "type": "fill", "selector": "#search", "value": "crimson-falcon-0" },
        { "type": "wait", "ms": 400 }
      ],
      "duration": 2000
    },
    {
      "continue": true,
      "transition": { "type": "cut", "duration": 0 },
      "actions": [
        { "type": "click", "selector": ".vl-del" },
        { "type": "wait", "ms": 220 }
      ],
      "animations": [
        { "selector": ".kerf-confirm", "property": "translateY", "from": "10px", "to": "0px", "duration": 280, "easing": "${easeOut}" }
      ],
      "duration": 1700
    },
    {
      "continue": true,
      "transition": { "type": "cut", "duration": 0 },
      "actions": [
        { "type": "click", "selector": ".kerf-confirm__ok" },
        { "type": "wait", "ms": 260 }
      ],
      "animations": [
        { "selector": ".kerf-toast", "property": "translateX", "from": "24px", "to": "0px", "duration": 300, "easing": "${easeOut}" }
      ],
      "duration": 2800
    }
  ]
}
