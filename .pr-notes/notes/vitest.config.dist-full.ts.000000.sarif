          "guid": "mt3pko4t0pzucxkw",
          "message": {
            "text": "Every new SUBPATH entry must be registered here or the dist-full suite silently mis-resolves it to dist/index.js (the barrel), where the subpath's exports don't exist — surfacing as '<export> is not a function' only in the dist-full run, not npm test. Adding router was required for the router unit tests to pass under dist-full. When adding a future subpath, add its dist/<name>.js mapping here alongside the tsup entry + package.json export.",
            "markdown": "Every new SUBPATH entry must be registered here or the dist-full suite silently mis-resolves it to `dist/index.js` (the barrel), where the subpath's exports don't exist — surfacing as '<export> is not a function' only in the dist-full run, not `npm test`. Adding `router` was required for the router unit tests to pass under dist-full. When adding a future subpath, add its `dist/<name>.js` mapping here alongside the tsup entry + package.json export."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "vitest.config.dist-full.ts"
                },
                "region": {
                  "startLine": 44,
                  "endLine": 44,
                  "snippet": {
                    "text": "  router: resolve(DIST, 'router.js'),"
                  }
                }
              }
            }
          ],
          "properties": {
