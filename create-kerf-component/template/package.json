{
  "name": "__PKG_NAME__",
  "version": "0.1.0",
  "description": "A reusable kerf component package.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./counter": {
      "types": "./dist/counter.d.ts",
      "import": "./dist/counter.js"
    },
    "./counter.css": "./src/counter.css"
  },
  "files": [
    "dist",
    "src/counter.css",
    "component-composition.json",
    "component-props.json",
    "kerf.components.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "catalog:generate": "node scripts/kerf-component-catalog.mjs --write",
    "catalog:check": "node scripts/kerf-component-catalog.mjs --check",
    "props:generate": "npm run build && kerf-ui-props --write",
    "props:check": "kerf-ui-props --check",
    "check:styles": "kerf-ui-analyze --root . src",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run catalog:check && npm run check:styles && npm run build && npm run props:check"
  },
  "kerfComponentCatalog": {
    "source": "./kerf.components.json",
    "output": "./component-composition.json",
    "propsOutput": "./component-props.json"
  },
  "peerDependencies": {
    "kerfjs": "^5.0.0"
  },
  "devDependencies": {
    "kerfjs": "^5.0.0",
    "@kerfjs/ui": "^5.0.0",
    "tsup": "^8",
    "typescript": "^5 || ^6"
  }
}
