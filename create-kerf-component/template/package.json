{
  "name": "__PKG_NAME__",
  "version": "0.1.0",
  "description": "A reusable kerf component package.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./counter": {
      "types": "./dist/counter.d.ts",
      "import": "./dist/counter.js"
    }
  },
  "files": [
    "dist",
    "component-catalog-v2.json",
    "kerf.components.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "catalog:generate": "node scripts/kerf-component-catalog.mjs --write",
    "catalog:check": "node scripts/kerf-component-catalog.mjs --check",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run catalog:check && npm run build"
  },
  "kerfComponentCatalog": {
    "source": "./kerf.components.json",
    "output": "./component-catalog-v2.json"
  },
  "peerDependencies": {
    "kerfjs": "^4.0.0"
  },
  "devDependencies": {
    "kerfjs": "^4.4.1",
    "tsup": "^8",
    "typescript": "^5 || ^6"
  }
}
