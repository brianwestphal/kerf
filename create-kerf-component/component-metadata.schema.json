{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/brianwestphal/kerf/main/create-kerf-component/component-metadata.schema.json",
  "title": "Kerf consumer component metadata source",
  "type": "object",
  "required": ["schemaVersion", "components"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "v1Catalog": { "type": "string", "minLength": 1 },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/component" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "cardinality": {
      "type": "object",
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "integer", "minimum": 0 },
        "max": {
          "anyOf": [
            { "type": "integer", "minimum": 1 },
            { "const": "unbounded" }
          ]
        }
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": ["id", "severity", "when", "message"],
      "properties": {
        "id": { "type": "string", "pattern": "^KUI-C[0-9]{3}$" },
        "severity": { "enum": ["error", "warning"] },
        "when": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind",
        "purpose",
        "source",
        "publicExports",
        "sourceLinks",
        "composition",
        "boundaries",
        "accessibility",
        "diagnostics",
        "provenance"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["component", "composition", "recipe"] },
        "purpose": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "publicExports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "subpath"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "subpath": { "type": "string", "pattern": "^\\." }
            },
            "additionalProperties": false
          }
        },
        "sourceLinks": { "$ref": "#/$defs/stringList" },
        "composition": { "$ref": "#/$defs/composition" },
        "boundaries": {
          "type": "object",
          "required": ["rootClass", "publicClasses", "publicTokens"],
          "properties": {
            "rootClass": {
              "oneOf": [
                { "type": "string", "minLength": 1 },
                { "type": "null" }
              ]
            },
            "publicClasses": { "$ref": "#/$defs/stringList" },
            "publicTokens": { "$ref": "#/$defs/stringList" }
          },
          "additionalProperties": false
        },
        "accessibility": {
          "type": "object",
          "required": ["obligations"],
          "properties": { "obligations": { "$ref": "#/$defs/stringList" } },
          "additionalProperties": false
        },
        "diagnostics": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagnostic" }
        },
        "provenance": {
          "type": "object",
          "required": ["selection", "composition"],
          "properties": {
            "selection": { "type": "string", "minLength": 1 },
            "composition": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "composition": {
      "type": "object",
      "required": [
        "parents",
        "contexts",
        "zones",
        "children",
        "state",
        "wiring",
        "responsive",
        "layout"
      ],
      "properties": {
        "parents": {
          "type": "object",
          "required": ["mode", "entries"],
          "properties": {
            "mode": { "enum": ["any", "root", "listed"] },
            "entries": { "$ref": "#/$defs/stringList" }
          },
          "additionalProperties": false
        },
        "contexts": { "$ref": "#/$defs/stringList" },
        "zones": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "accepts", "cardinality", "exclusiveWith"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "accepts": { "$ref": "#/$defs/stringList" },
              "cardinality": { "$ref": "#/$defs/cardinality" },
              "exclusiveWith": { "$ref": "#/$defs/stringList" }
            },
            "additionalProperties": false
          }
        },
        "children": {
          "type": "object",
          "required": ["mode", "concepts", "requiredConcepts"],
          "properties": {
            "mode": { "enum": ["any", "none", "listed"] },
            "concepts": { "$ref": "#/$defs/stringList" },
            "requiredConcepts": { "$ref": "#/$defs/stringList" }
          },
          "additionalProperties": false
        },
        "state": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "owner", "required"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "owner": { "enum": ["application", "controlled", "component"] },
              "required": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "wiring": {
          "type": "object",
          "required": ["required", "helpers", "obligations"],
          "properties": {
            "required": { "type": "boolean" },
            "helpers": { "$ref": "#/$defs/stringList" },
            "obligations": { "$ref": "#/$defs/stringList" }
          },
          "additionalProperties": false
        },
        "responsive": {
          "type": "object",
          "required": ["owner", "behaviors"],
          "properties": {
            "owner": {
              "enum": ["application", "component", "shared", "not-applicable"]
            },
            "behaviors": { "$ref": "#/$defs/stringList" }
          },
          "additionalProperties": false
        },
        "layout": {
          "type": "object",
          "required": ["roles", "geometry"],
          "properties": {
            "roles": { "$ref": "#/$defs/stringList" },
            "geometry": {
              "type": "object",
              "required": ["margin", "border", "padding"],
              "properties": {
                "margin": { "$ref": "#/$defs/geometryOwner" },
                "border": { "$ref": "#/$defs/geometryOwner" },
                "padding": { "$ref": "#/$defs/geometryOwner" },
                "notes": { "$ref": "#/$defs/stringList" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "geometryOwner": {
      "enum": ["self", "parent", "child", "none", "conditional", "composed"]
    }
  }
}
