{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/brianwestphal/kerf/main/create-kerf-component/component-metadata.schema.json",
  "title": "Kerf consumer component metadata source",
  "type": "object",
  "required": ["schemaVersion", "components"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "componentCatalog": {
      "type": "string",
      "minLength": 1,
      "description": "Relative path to the package's component (selection) catalog, copied into the generated composition catalog's compatibility.componentCatalog. When package.json#kerfComponentCatalog.selectionOutput is configured and this is absent or \"not-applicable\", the generator derives it from that output path; otherwise it defaults to \"not-applicable\"."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "One-line description of the package's components, emitted as the selection catalog's description. Required when package.json#kerfComponentCatalog.selectionOutput is configured."
    },
    "components": {
      "type": "array",
      "items": { "$ref": "#/$defs/component" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "propCondition": {
      "type": "object",
      "required": ["prop", "equals"],
      "properties": {
        "prop": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]*$",
          "description": "A JSX prop of the element."
        },
        "equals": {
          "anyOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "boolean" }
          ],
          "description": "The statically written value that satisfies the condition. A bare boolean prop (<Card flush />) equals true."
        }
      },
      "additionalProperties": false
    },
    "stateAttribute": {
      "type": "object",
      "required": ["name", "on", "helper", "meaning"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^data-[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "on": {
          "type": "string",
          "minLength": 1,
          "description": "The element that carries it: a public class, or the element passed to the helper."
        },
        "helper": {
          "type": "string",
          "minLength": 1,
          "description": "The helper, one of wiring.helpers, that writes it."
        },
        "meaning": {
          "type": "string",
          "minLength": 1,
          "description": "What its presence or value means."
        }
      },
      "additionalProperties": false
    },
    "repositoryPath": {
      "description": "A package-relative POSIX path without traversal or empty segments.",
      "type": "string",
      "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "selection": {
      "description": "Selection facts for the generated selection catalog (package.json#kerfComponentCatalog.selectionOutput). name, kind, purpose, source, publicClasses, publicTokens, and geometry are derived from the component; only the facts the composition metadata cannot express live here. Required on every component and composition when selectionOutput is configured; recipes are not selection entries.",
      "type": "object",
      "required": ["useWhen", "avoidWhen"],
      "properties": {
        "useWhen": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "avoidWhen": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "uses": {
          "description": "Directly composed catalog entry ids: this package's own component ids or @kerfjs/ui selection catalog ids.",
          "$ref": "#/$defs/stringList"
        },
        "styleSources": {
          "description": "Stylesheets this component owns, relative to the package root.",
          "type": "array",
          "items": {
            "allOf": [
              { "$ref": "#/$defs/repositoryPath" },
              { "pattern": "\\.css$" }
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "demoSource": { "$ref": "#/$defs/repositoryPath" },
        "documentation": { "type": "string", "minLength": 1 },
        "geometry": {
          "description": "Overrides composition.layout.geometry in the selection catalog. Required when that geometry uses the composition-only owner \"composed\".",
          "type": "object",
          "required": ["margin", "border", "padding"],
          "properties": {
            "margin": { "$ref": "#/$defs/selectionGeometryOwner" },
            "border": { "$ref": "#/$defs/selectionGeometryOwner" },
            "padding": { "$ref": "#/$defs/selectionGeometryOwner" },
            "notes": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "selectionGeometryOwner": {
      "enum": ["self", "parent", "child", "none", "conditional"]
    },
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "cardinality": {
      "type": "object",
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "integer", "minimum": 0 },
        "max": {
          "anyOf": [
            { "type": "integer", "minimum": 1 },
            { "const": "unbounded" }
          ]
        }
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": ["id", "severity", "when", "message"],
      "properties": {
        "id": { "type": "string", "pattern": "^KUI-C[0-9]{3}$" },
        "severity": { "enum": ["error", "warning"] },
        "when": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind",
        "purpose",
        "source",
        "publicExports",
        "sourceLinks",
        "composition",
        "boundaries",
        "accessibility",
        "diagnostics",
        "provenance"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["component", "composition", "recipe"] },
        "purpose": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "publicExports": {
          "type": "array",
          "minItems": 1,
          "description": "Each export's name and package.json#exports subpath. A private application (package.json#private) may omit subpath; the name is then verified against the component's source file.",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "subpath": { "type": "string", "pattern": "^\\." }
            },
            "additionalProperties": false
          }
        },
        "sourceLinks": { "$ref": "#/$defs/stringList" },
        "composition": { "$ref": "#/$defs/composition" },
        "boundaries": {
          "type": "object",
          "required": ["rootClass", "publicClasses", "publicTokens"],
          "properties": {
            "rootClass": {
              "oneOf": [
                { "type": "string", "minLength": 1 },
                { "type": "null" }
              ]
            },
            "publicClasses": { "$ref": "#/$defs/stringList" },
            "placeableClasses": {
              "$ref": "#/$defs/stringList",
              "description": "The subset of publicClasses an application may place on its own elements (a layout utility, item geometry on another carrier). Absent means none: every public class is the component's rendered anatomy, which eslint-plugin-kerfjs reports on an application-owned element as KUI-L103 with the component to render."
            },
            "rootElement": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
              "description": "The intrinsic element the component renders around its own placeableClasses. A placeable class on a plain element of this tag is the component recreated (KUI-L103); another carrier element keeps it. Requires placeableClasses."
            },
            "publicTokens": { "$ref": "#/$defs/stringList" }
          },
          "additionalProperties": false
        },
        "accessibility": {
          "type": "object",
          "required": ["obligations"],
          "properties": { "obligations": { "$ref": "#/$defs/stringList" } },
          "additionalProperties": false
        },
        "diagnostics": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagnostic" }
        },
        "provenance": {
          "type": "object",
          "required": ["selection", "composition"],
          "properties": {
            "selection": { "type": "string", "minLength": 1 },
            "composition": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "selection": { "$ref": "#/$defs/selection" }
      },
      "additionalProperties": false
    },
    "composition": {
      "type": "object",
      "required": [
        "parents",
        "contexts",
        "zones",
        "children",
        "state",
        "wiring",
        "responsive",
        "layout"
      ],
      "properties": {
        "rendersAs": {
          "description": "For a wrapper component: the cataloged roots it renders (package-qualified keys such as @kerfjs/ui:toolbar-control-group), any one of them or nothing. UI composition checks treat the wrapper as each declared root.",
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[^:]+:[^:]+$" },
          "uniqueItems": true
        },
        "insetFreeChildren": {
          "description": "Prop values under which this component's direct JSX children must bring no content-item inset (for example an embedded appearance that already insets its content). While any condition holds, a child whose layout.geometry is self on margin, border, and padding double-insets this component unless one of the child's insetFreeWhen conditions holds; eslint-plugin-kerfjs reports it as KUI-L204.",
          "type": "array",
          "items": { "$ref": "#/$defs/propCondition" },
          "minItems": 1
        },
        "insetFreeWhen": {
          "description": "Prop values that render this inset-bearing component with no margin, border, or padding of its own (for example a flush prop). Any one condition makes the element inset-free inside a parent that declares insetFreeChildren.",
          "type": "array",
          "items": { "$ref": "#/$defs/propCondition" },
          "minItems": 1
        },
        "parents": {
          "type": "object",
          "required": ["mode", "entries"],
          "properties": {
            "mode": { "enum": ["any", "root", "listed"] },
            "entries": { "$ref": "#/$defs/stringList" }
          },
          "additionalProperties": false
        },
        "contexts": { "$ref": "#/$defs/stringList" },
        "zones": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "accepts", "cardinality", "exclusiveWith"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "jsx": {
                "description": "The JSX prop that fills this zone (children for the default slot), so composition checks can map a prop's value to its zone. Unique per component.",
                "type": "object",
                "required": ["prop"],
                "properties": {
                  "prop": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false
              },
              "accepts": { "$ref": "#/$defs/stringList" },
              "cardinality": { "$ref": "#/$defs/cardinality" },
              "exclusiveWith": { "$ref": "#/$defs/stringList" }
            },
            "additionalProperties": false
          }
        },
        "children": {
          "type": "object",
          "required": ["mode", "concepts", "requiredConcepts"],
          "properties": {
            "mode": { "enum": ["any", "none", "listed"] },
            "concepts": { "$ref": "#/$defs/stringList" },
            "requiredConcepts": { "$ref": "#/$defs/stringList" }
          },
          "additionalProperties": false
        },
        "state": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "owner", "required"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "owner": { "enum": ["application", "controlled", "component"] },
              "required": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "wiring": {
          "type": "object",
          "required": ["required", "helpers", "obligations"],
          "properties": {
            "required": { "type": "boolean" },
            "scope": {
              "description": "Where a required helper must run: application (default) anywhere reachable from a profile wiring entry, or module in the module that renders the component.",
              "enum": ["application", "module"]
            },
            "helpers": { "$ref": "#/$defs/stringList" },
            "sources": {
              "description": "Where each application-owned helper in helpers is defined: its export name and source file relative to the package root. UI lint resolves relative imports of these helpers to verify page-root wiring (KUI-L401).",
              "type": "array",
              "items": {
                "type": "object",
                "required": ["export", "source"],
                "properties": {
                  "export": { "type": "string", "minLength": 1 },
                  "source": { "type": "string", "minLength": 1 },
                  "returnsDisposer": { "type": "boolean" }
                },
                "additionalProperties": false
              }
            },
            "actions": {
              "description": "data-action values the application must handle with a root-delegated listener (delegate or delegateActions) instead of a named helper. Required wiring names at least one helper or action; UI lint verifies a reachable handler (KUI-L401).",
              "$ref": "#/$defs/stringList"
            },
            "obligations": { "$ref": "#/$defs/stringList" },
            "stateAttributes": {
              "description": "Optional wiring-owned state attributes: data-* attributes a wiring helper writes at runtime, which the application must not render, remove, or treat as its own state.",
              "type": "array",
              "items": { "$ref": "#/$defs/stateAttribute" }
            }
          },
          "additionalProperties": false
        },
        "responsive": {
          "type": "object",
          "required": ["owner", "behaviors"],
          "properties": {
            "owner": {
              "enum": ["application", "component", "shared", "not-applicable"]
            },
            "behaviors": { "$ref": "#/$defs/stringList" }
          },
          "additionalProperties": false
        },
        "layout": {
          "type": "object",
          "required": ["roles", "geometry"],
          "properties": {
            "roles": {
              "description": "One or more grouping roles for selection and catalog navigation. Prefer @kerfjs/ui's vocabulary so merged catalogs group consistently: structure, navigation, controls, actions, forms, feedback, foundation, media, layout, helpers, reference-composition (see docs/13-component-packages.md, Layout roles).",
              "$ref": "#/$defs/stringList"
            },
            "geometry": {
              "type": "object",
              "required": ["margin", "border", "padding"],
              "properties": {
                "margin": { "$ref": "#/$defs/geometryOwner" },
                "border": { "$ref": "#/$defs/geometryOwner" },
                "padding": { "$ref": "#/$defs/geometryOwner" },
                "notes": { "$ref": "#/$defs/stringList" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "geometryOwner": {
      "enum": ["self", "parent", "child", "none", "conditional", "composed"]
    }
  }
}
